 {
       "name": "FlutterProject Dev Container",
       "image": "cirrusci/flutter:latest",
       "forwardPorts": [
         3000
       ],
       "extensions": [
         "dart-code.dart-code",
         "dart-code.flutter"
      ],
      "postCreateCommand": "flutter doctor -v",
      "settings": {
        "terminal.integrated.shell.linux": "/bin/bash"
      },
      "remoteUser": "flutter"
    }
