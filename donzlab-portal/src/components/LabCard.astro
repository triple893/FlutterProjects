---
import { Image } from "emdash/ui";
import WorldArt from "./WorldArt.astro";
import type { Lab } from "../../emdash-env";

interface Props {
	lab: { id: string; data: Lab; edit: Record<string, Record<string, string>> };
}

const { lab } = Astro.props;
const accent = lab.data.accent ?? undefined;
---

<a class="gate" href={`/labs/${lab.id}`} style={accent ? `--accent:${accent}` : undefined}>
	<div class="thumb" style={`view-transition-name: world-${lab.id}`}>
		{
			lab.data.thumbnail ? (
				<div {...lab.edit.thumbnail}>
					<Image image={lab.data.thumbnail} />
				</div>
			) : (
				<WorldArt world={lab.data.world} accent={accent} seed={lab.id} variant="thumb" />
			)
		}
	</div>
	<div class="label">
		{lab.data.lab_status && <span class="badge" data-status={lab.data.lab_status}>{lab.data.lab_status}</span>}
		<h3 {...lab.edit.title}>{lab.data.title}</h3>
		{lab.data.tagline && <p {...lab.edit.tagline}>{lab.data.tagline}</p>}
		<span class="enter-cue" aria-hidden="true">入る →</span>
	</div>
</a>

<style>
	.gate {
		position: relative;
		display: flex;
		flex-direction: column;
		border-radius: var(--radius);
		overflow: hidden;
		background: #0b0c12;
		border: 1px solid var(--line);
		color: var(--text);
		isolation: isolate;
		transition:
			transform 0.35s cubic-bezier(0.2, 0.7, 0.2, 1),
			border-color 0.35s ease,
			box-shadow 0.35s ease;
	}

	.gate:hover,
	.gate:focus-visible {
		text-decoration: none;
		transform: translateY(-6px);
		border-color: var(--accent);
		box-shadow:
			0 18px 50px -20px var(--accent),
			0 0 0 1px var(--accent);
	}

	.thumb {
		aspect-ratio: 16 / 10;
		overflow: hidden;
	}

	.thumb :global(svg),
	.thumb :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 0.8s cubic-bezier(0.2, 0.7, 0.2, 1);
	}

	.gate:hover .thumb :global(svg),
	.gate:hover .thumb :global(img) {
		transform: scale(1.08);
	}

	.label {
		position: relative;
		padding: 16px 18px 18px;
		background: linear-gradient(180deg, rgba(11, 12, 18, 0) 0%, #0b0c12 30%);
		margin-top: -40px;
	}

	.label h3 {
		margin: 6px 0 2px;
		font-size: 1.15rem;
	}

	.label p {
		margin: 0;
		color: var(--text-muted);
		font-size: 0.88rem;
	}

	.enter-cue {
		position: absolute;
		right: 18px;
		bottom: 16px;
		color: var(--accent);
		font-size: 0.85rem;
		opacity: 0;
		transform: translateX(-6px);
		transition:
			opacity 0.3s ease,
			transform 0.3s ease;
	}

	.gate:hover .enter-cue {
		opacity: 1;
		transform: none;
	}
</style>
