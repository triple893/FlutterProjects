---
import { Image } from "emdash/ui";
import GateMotif from "./GateMotif.astro";
import Status from "./Status.astro";
import { gateNumeral } from "../utils/format";
import type { Lab } from "../../emdash-env";

interface Props {
	lab: { id: string; data: Lab; edit: Record<string, Record<string, string>> };
	/** Zero-based position among the gates, shown as 壱, 弐, 参… */
	index: number;
}

const { lab, index } = Astro.props;
// The fan portal's stage keeps its own vermilion; every other gate is gold.
const tinted = lab.data.world === "stage";
---

<a
	class:list={["gate frame", { tinted }]}
	href={`/labs/${lab.id}`}
	style={`view-transition-name: gate-${lab.id}`}
>
	<div class="frame-inner">
		<div class="gate-top">
			<span class="numeral">{gateNumeral(index)}</span>
			<Status status={lab.data.lab_status} />
		</div>
		{
			lab.data.thumbnail ? (
				<div class="thumb" {...lab.edit.thumbnail}>
					<Image image={lab.data.thumbnail} />
				</div>
			) : (
				<GateMotif world={lab.data.world} label={`${lab.data.title}の紋`} />
			)
		}
		<div class="gate-text">
			<h3 {...lab.edit.title}>{lab.data.title}</h3>
			{lab.data.name_en && <p class="gate-en" {...lab.edit.name_en}>{lab.data.name_en}</p>}
			{lab.data.tagline && <p class="gate-tagline" {...lab.edit.tagline}>{lab.data.tagline}</p>}
		</div>
	</div>
</a>

<style>
	.gate {
		color: var(--gold);
		transition:
			border-color 0.3s ease,
			transform 0.3s cubic-bezier(0.2, 0.7, 0.2, 1);
	}

	.gate:hover {
		border-color: var(--gold);
		transform: translateY(-4px);
	}

	.gate.tinted {
		color: #e46a4f;
		border-color: rgba(210, 70, 43, 0.45);
		background: #140b0a;
	}

	.gate.tinted .frame-inner {
		border-color: rgba(210, 70, 43, 0.25);
	}

	.gate-top {
		display: flex;
		justify-content: space-between;
		align-items: center;
	}

	.numeral {
		font-family: var(--font-display);
		font-size: 28px;
		line-height: 1;
		transition: color 0.3s ease;
	}

	.gate:hover .numeral {
		color: var(--shu);
	}

	.thumb {
		height: 160px;
		overflow: hidden;
	}

	.thumb :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.gate-text {
		display: flex;
		flex-direction: column;
		gap: 6px;
	}

	h3 {
		margin: 0;
		font-weight: 700;
		font-size: 26px;
		line-height: 1.35;
	}

	.gate-en {
		margin: 0;
		font-family: var(--font-mono);
		font-size: 11px;
		letter-spacing: 0.2em;
		text-transform: uppercase;
		color: var(--text-faint);
	}

	.gate-tagline {
		margin: 8px 0 0;
		font-size: 14px;
		line-height: 1.8;
		color: var(--text-muted);
	}
</style>
