---
import { Image } from "emdash/ui";
import type { Agent } from "../../emdash-env";

interface Props {
	agent: { id: string; data: Agent; edit: Record<string, Record<string, string>> };
	/** Portrait diameter in px */
	size?: number;
}

const { agent, size = 96 } = Astro.props;
const layer = agent.data.layer ?? "街";
---

<a class="medallion" href={`/agents/${agent.id}`} data-layer={layer} style={`--size:${size}px`}>
	<span class="portrait" {...agent.edit.portrait} style={`view-transition-name: agent-${agent.id}`}>
		{agent.data.portrait ? <Image image={agent.data.portrait} /> : <span aria-hidden="true">{agent.data.title.slice(0, 1)}</span>}
	</span>
	<span class="name" {...agent.edit.title}>{agent.data.title}</span>
	{agent.data.epithet && <span class="epithet" {...agent.edit.epithet}>{agent.data.epithet}</span>}
</a>

<style>
	.medallion {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 10px;
		text-align: center;
		color: var(--text);
		max-width: calc(var(--size) + 64px);
	}

	.portrait {
		width: var(--size);
		height: var(--size);
		border-radius: 50%;
		overflow: hidden;
		display: grid;
		place-items: center;
		font-family: var(--font-display);
		font-size: calc(var(--size) * 0.38);
		transition: box-shadow 0.3s ease;
	}

	.portrait :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	/* 天: gold halo ring */
	[data-layer="天"] .portrait,
	[data-layer="本陣"] .portrait {
		border: 1px solid var(--gold);
		background: #12100c;
		color: var(--gold-soft);
		box-shadow:
			0 0 0 6px var(--ink-raised),
			0 0 0 7px rgba(201, 162, 74, 0.5);
	}

	[data-layer="天"]:hover .portrait {
		box-shadow:
			0 0 0 6px var(--ink-raised),
			0 0 0 7px rgba(201, 162, 74, 0.8),
			0 0 40px rgba(201, 162, 74, 0.35);
	}

	/* 街: lantern light */
	[data-layer="街"] .portrait {
		border: 1px solid #e58a55;
		background: #22160f;
		color: #f3c8a5;
	}

	[data-layer="復活待ち"] .portrait {
		border: 1px dashed var(--text-faint);
		color: var(--text-faint);
	}

	.name {
		font-family: var(--font-display);
		font-size: 17px;
	}

	.epithet {
		font-size: 12px;
		color: var(--text-faint);
	}
</style>
