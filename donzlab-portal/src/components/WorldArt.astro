---
/**
 * Generative backdrop for a lab's "world". Pure SVG + CSS animation, so a lab
 * looks finished before anyone uploads artwork. Deterministic per `seed`.
 */
interface Props {
	world?: string | null;
	accent?: string | null;
	seed?: string;
	/** "thumb" for cards, "hero" for full-bleed backgrounds */
	variant?: "thumb" | "hero";
	class?: string;
}

const { world = "circuit", accent, seed = "donz", variant = "thumb", class: className } = Astro.props;
const color = accent && /^#[0-9a-f]{6}$/i.test(accent) ? accent : "#d9b45a";

// Small deterministic PRNG so every render of a lab draws the same picture.
let state = [...seed].reduce((h, c) => (h * 31 + c.charCodeAt(0)) >>> 0, 2166136261);
const rand = () => {
	state = (state * 1664525 + 1013904223) >>> 0;
	return state / 4294967296;
};
const W = 800;
const H = 500;
const r = (min: number, max: number) => min + rand() * (max - min);

// circuit: right-angled traces running toward a central core
const traces = Array.from({ length: 18 }, (_, i) => {
	const side = i % 4;
	const sx = side === 0 ? 0 : side === 1 ? W : r(0, W);
	const sy = side === 2 ? 0 : side === 3 ? H : r(0, H);
	const mx = side < 2 ? r(W * 0.25, W * 0.75) : sx;
	const my = side < 2 ? sy : r(H * 0.25, H * 0.75);
	const ex = W / 2 + r(-60, 60);
	const ey = H / 2 + r(-40, 40);
	return { d: `M${sx.toFixed(0)},${sy.toFixed(0)} L${mx.toFixed(0)},${my.toFixed(0)} L${ex.toFixed(0)},${my.toFixed(0)} L${ex.toFixed(0)},${ey.toFixed(0)}`, end: [mx, my], delay: r(0, 6) };
});

// strings: six vibrating strings
const strings = Array.from({ length: 6 }, (_, i) => {
	const y = 110 + i * 56;
	const amp = 6 + i * 2.2;
	return { y, a: `M0,${y} Q${W / 2},${y + amp} ${W},${y}`, b: `M0,${y} Q${W / 2},${y - amp} ${W},${y}`, w: 1 + (5 - i) * 0.5, dur: 0.18 + i * 0.05 };
});

// sound: equalizer bars
const bars = Array.from({ length: 32 }, (_, i) => ({ x: 20 + i * 24, h: r(40, 220), delay: r(0, 1.2) }));

// kitchen: steam wisps and pasta waves
const steam = Array.from({ length: 7 }, (_, i) => ({ x: 120 + i * 95 + r(-20, 20), delay: r(0, 5) }));
const waves = Array.from({ length: 9 }, (_, i) => {
	const y = 330 + i * 16;
	let d = `M0,${y}`;
	for (let x = 0; x <= W; x += 40) d += ` Q${x + 20},${y + (i % 2 ? 10 : -10)} ${x + 40},${y}`;
	return d;
});

// constellation: nodes linked to their neighbours
const nodes = Array.from({ length: 34 }, () => ({ x: r(30, W - 30), y: r(30, H - 30), s: r(1.2, 3.6), delay: r(0, 5) }));
const edges: [number, number][] = [];
nodes.forEach((a, i) =>
	nodes.forEach((b, j) => {
		if (j > i && Math.hypot(a.x - b.x, a.y - b.y) < 150) edges.push([i, j]);
	}),
);

// device: floating phones
const phones = Array.from({ length: 5 }, (_, i) => ({ x: 70 + i * 150 + r(-20, 20), y: r(90, 220), rot: r(-14, 14), delay: i * 0.7 }));

// stage: spotlights sweeping over a stage, with sparkles in the air
const beams = Array.from({ length: 5 }, (_, i) => ({ x: 80 + i * 160, delay: i * 0.9, dir: i % 2 ? 1 : -1 }));
const sparkles = Array.from({ length: 26 }, () => ({ x: r(20, W - 20), y: r(20, H * 0.7), s: r(1.5, 4), delay: r(0, 4) }));

const id = `w-${seed.replace(/[^a-z0-9]/gi, "")}-${variant}`;
---

<svg
	class:list={["world-art", `world-${world}`, `world-${variant}`, className]}
	viewBox={`0 0 ${W} ${H}`}
	preserveAspectRatio="xMidYMid slice"
	role="img"
	aria-hidden="true"
	style={`--accent:${color}`}
>
	<defs>
		<radialGradient id={`${id}-glow`} cx="50%" cy="50%" r="60%">
			<stop offset="0%" stop-color={color} stop-opacity="0.35" />
			<stop offset="100%" stop-color={color} stop-opacity="0" />
		</radialGradient>
		<linearGradient id={`${id}-fade`} x1="0" y1="0" x2="0" y2="1">
			<stop offset="0%" stop-color={color} stop-opacity="0.9" />
			<stop offset="100%" stop-color={color} stop-opacity="0.1" />
		</linearGradient>
	</defs>

	{world !== "business" && <rect class="bg" width={W} height={H} />}
	{world !== "business" && <rect width={W} height={H} fill={`url(#${id}-glow)`} />}

	{
		world === "circuit" && (
			<g class="circuit">
				{traces.map((t) => (
					<>
						<path class="trace" d={t.d} />
						<path class="pulse" d={t.d} style={`animation-delay:-${t.delay.toFixed(2)}s`} />
						<circle class="node" cx={t.end[0]} cy={t.end[1]} r="3" />
					</>
				))}
				<circle class="halo halo-1" cx={W / 2} cy={H / 2} r="92" />
				<circle class="halo halo-2" cx={W / 2} cy={H / 2} r="70" />
				<circle class="core" cx={W / 2} cy={H / 2} r="26" />
			</g>
		)
	}

	{
		world === "strings" && (
			<g class="strings">
				{Array.from({ length: 9 }, (_, i) => (
					<line class="fret" x1={60 + i * 85} y1="80" x2={60 + i * 85} y2="420" />
				))}
				{strings.map((s) => (
					<path class="string" d={s.a} stroke-width={s.w}>
						<animate attributeName="d" values={`${s.a};${s.b};${s.a}`} dur={`${s.dur}s`} repeatCount="indefinite" />
					</path>
				))}
				{[180, 350, 520, 640].map((x, i) => (
					<circle class="note" cx={x} cy={110 + i * 56 * 1.4} r="11" style={`animation-delay:-${i * 0.8}s`} />
				))}
			</g>
		)
	}

	{
		world === "sound" && (
			<g class="sound">
				{[60, 120, 180, 240, 300].map((rr, i) => (
					<circle class="ring" cx={W / 2} cy={H / 2 - 40} r={rr} style={`animation-delay:-${i * 0.9}s`} />
				))}
				{bars.map((b) => (
					<rect class="bar" x={b.x} y={H - b.h} width="14" height={b.h} rx="3" fill={`url(#${id}-fade)`} style={`animation-delay:-${b.delay.toFixed(2)}s`} />
				))}
			</g>
		)
	}

	{
		world === "kitchen" && (
			<g class="kitchen">
				{waves.map((d) => (
					<path class="wave" d={d} />
				))}
				{steam.map((s) => (
					<path class="steam" d={`M${s.x},320 C${s.x - 30},260 ${s.x + 30},210 ${s.x},150 S${s.x - 20},70 ${s.x + 10},20`} style={`animation-delay:-${s.delay.toFixed(2)}s`} />
				))}
			</g>
		)
	}

	{
		world === "signal" && (
			<g class="signal">
				{[0, 1, 2, 3, 4, 5].map((i) => (
					<circle class="wave-ring" cx={W * 0.5} cy={H * 0.55} r="40" style={`animation-delay:-${i * 0.8}s`} />
				))}
				<circle class="tower" cx={W * 0.5} cy={H * 0.55} r="10" />
				{nodes.slice(0, 18).map((n) => (
					<circle class="dot" cx={n.x} cy={n.y} r={n.s} style={`animation-delay:-${n.delay.toFixed(2)}s`} />
				))}
			</g>
		)
	}

	{
		world === "constellation" && (
			<g class="constellation">
				{edges.map(([a, b]) => (
					<line class="edge" x1={nodes[a].x} y1={nodes[a].y} x2={nodes[b].x} y2={nodes[b].y} />
				))}
				{nodes.map((n) => (
					<circle class="star" cx={n.x} cy={n.y} r={n.s} style={`animation-delay:-${n.delay.toFixed(2)}s`} />
				))}
			</g>
		)
	}

	{
		world === "stage" && (
			<g class="stage">
				<defs>
					<linearGradient id={`${id}-beam`} x1="0" y1="0" x2="0" y2="1">
						<stop offset="0%" stop-color="#ffffff" stop-opacity="0.55" />
						<stop offset="100%" stop-color={color} stop-opacity="0" />
					</linearGradient>
				</defs>
				{beams.map((b) => (
					<polygon
						class="beam"
						points={`${b.x - 6},0 ${b.x + 6},0 ${b.x + 120},${H} ${b.x - 120},${H}`}
						fill={`url(#${id}-beam)`}
						style={`transform-origin:${b.x}px 0px;animation-delay:-${b.delay}s;--dir:${b.dir}`}
					/>
				))}
				<rect class="floor" x="0" y={H - 70} width={W} height="70" />
				<line class="floor-edge" x1="0" y1={H - 70} x2={W} y2={H - 70} />
				{sparkles.map((p) => (
					<path
						class="sparkle"
						d={`M${p.x},${p.y - p.s * 2} L${p.x + p.s * 0.5},${p.y} L${p.x},${p.y + p.s * 2} L${p.x - p.s * 0.5},${p.y} Z M${p.x - p.s * 2},${p.y} L${p.x},${p.y + p.s * 0.5} L${p.x + p.s * 2},${p.y} L${p.x},${p.y - p.s * 0.5} Z`}
						style={`animation-delay:-${p.delay.toFixed(2)}s`}
					/>
				))}
			</g>
		)
	}

	{
		world === "device" && (
			<g class="device">
				{phones.map((p) => (
					<g class="phone" style={`animation-delay:-${p.delay}s`}>
						<g transform={`translate(${p.x} ${p.y}) rotate(${p.rot.toFixed(1)})`}>
							<rect class="frame" width="110" height="200" rx="18" />
							<rect class="screen" x="8" y="14" width="94" height="172" rx="10" fill={`url(#${id}-fade)`} />
							<rect class="ui" x="20" y="40" width="70" height="8" rx="4" />
							<rect class="ui" x="20" y="58" width="48" height="8" rx="4" />
							<rect class="ui" x="20" y="120" width="70" height="40" rx="8" />
						</g>
					</g>
				))}
			</g>
		)
	}

	{
		world === "business" && (
			<g class="business">
				<rect class="bg-light" width={W} height={H} />
				{Array.from({ length: 11 }, (_, i) => (
					<line class="grid" x1={i * 80} y1="0" x2={i * 80} y2={H} />
				))}
				{Array.from({ length: 7 }, (_, i) => (
					<line class="grid" x1="0" y1={i * 80} x2={W} y2={i * 80} />
				))}
				{[150, 230, 190, 300, 260, 360].map((h, i) => (
					<rect class="col" x={150 + i * 90} y={H - 60 - h} width="44" height={h} rx="4" />
				))}
				<polyline class="trend" points="172,280 262,210 352,240 442,150 532,170 622,90" />
			</g>
		)
	}
</svg>

<style>
	.world-art {
		display: block;
		width: 100%;
		height: 100%;
	}

	.bg {
		fill: #07080c;
	}

	/* circuit */
	.trace {
		fill: none;
		stroke: var(--accent);
		stroke-opacity: 0.28;
		stroke-width: 1.5;
	}
	.pulse {
		fill: none;
		stroke: var(--accent);
		stroke-width: 2.5;
		stroke-dasharray: 18 520;
		animation: flow 6s linear infinite;
		filter: drop-shadow(0 0 4px var(--accent));
	}
	.node {
		fill: var(--accent);
		opacity: 0.6;
	}
	.halo,
	.ring,
	.wave-ring {
		fill: none;
		stroke: var(--accent);
		transform-box: fill-box;
		transform-origin: center;
	}
	.halo-1 {
		stroke-width: 2;
		stroke-dasharray: 4 10;
		animation: spin 40s linear infinite;
	}
	.halo-2 {
		stroke-opacity: 0.5;
		stroke-dasharray: 60 30;
		animation: spin 24s linear infinite reverse;
	}
	.core {
		fill: var(--accent);
		filter: drop-shadow(0 0 18px var(--accent));
		transform-box: fill-box;
		transform-origin: center;
		animation: breathe 4s ease-in-out infinite;
	}

	/* strings */
	.fret {
		stroke: #ffffff;
		stroke-opacity: 0.08;
		stroke-width: 3;
	}
	.string {
		fill: none;
		stroke: var(--accent);
		filter: drop-shadow(0 0 3px var(--accent));
	}
	.note {
		fill: var(--accent);
		opacity: 0.85;
		transform-box: fill-box;
		transform-origin: center;
		animation: breathe 3.2s ease-in-out infinite;
	}

	/* sound */
	.ring {
		stroke-opacity: 0.4;
		animation: ripple 4.5s ease-out infinite;
	}
	.bar {
		transform-box: fill-box;
		transform-origin: bottom;
		animation: eq 1.4s ease-in-out infinite alternate;
	}

	/* kitchen */
	.world-kitchen .bg {
		fill: #1a0d09;
	}
	.wave {
		fill: none;
		stroke: #f6deb0;
		stroke-opacity: 0.55;
		stroke-width: 4;
		stroke-linecap: round;
	}
	.steam {
		fill: none;
		stroke: #ffffff;
		stroke-opacity: 0.35;
		stroke-width: 10;
		stroke-linecap: round;
		filter: blur(4px);
		animation: rise 6s ease-in-out infinite;
	}

	/* signal */
	.wave-ring {
		stroke-width: 2;
		animation: broadcast 4.8s ease-out infinite;
	}
	.tower,
	.dot {
		fill: var(--accent);
	}
	.dot {
		animation: twinkle 3s ease-in-out infinite;
	}

	/* constellation */
	.world-constellation .bg {
		fill: #060818;
	}
	.edge {
		stroke: var(--accent);
		stroke-opacity: 0.22;
	}
	.star {
		fill: #ffffff;
		filter: drop-shadow(0 0 4px var(--accent));
		animation: twinkle 4s ease-in-out infinite;
	}

	/* stage */
	.world-stage .bg {
		fill: #12040a;
	}
	.beam {
		mix-blend-mode: screen;
		animation: sweep 6s ease-in-out infinite alternate;
	}
	.floor {
		fill: color-mix(in srgb, var(--accent) 22%, #12040a);
	}
	.floor-edge {
		stroke: var(--accent);
		stroke-width: 3;
		filter: drop-shadow(0 0 8px var(--accent));
	}
	.sparkle {
		fill: #ffffff;
		filter: drop-shadow(0 0 4px var(--accent));
		animation: twinkle 2.6s ease-in-out infinite;
	}
	@keyframes sweep {
		from {
			transform: rotate(calc(var(--dir) * -14deg));
		}
		to {
			transform: rotate(calc(var(--dir) * 14deg));
		}
	}

	/* device */
	.world-device .bg {
		fill: #061019;
	}
	.phone {
		animation: float 7s ease-in-out infinite;
	}
	.frame {
		fill: #0d1b26;
		stroke: var(--accent);
		stroke-opacity: 0.6;
	}
	.screen {
		opacity: 0.55;
	}
	.ui {
		fill: #ffffff;
		opacity: 0.55;
	}

	/* business: clean, static */
	.bg-light {
		fill: #f5f7fb;
	}
	.grid {
		stroke: #dfe5ef;
	}
	.col {
		fill: var(--accent);
		opacity: 0.18;
	}
	.trend {
		fill: none;
		stroke: var(--accent);
		stroke-width: 4;
		stroke-linejoin: round;
	}

	@keyframes flow {
		to {
			stroke-dashoffset: -538;
		}
	}
	@keyframes spin {
		to {
			transform: rotate(360deg);
		}
	}
	@keyframes breathe {
		50% {
			transform: scale(1.18);
			opacity: 0.7;
		}
	}
	@keyframes ripple {
		0% {
			transform: scale(0.6);
			stroke-opacity: 0.7;
		}
		100% {
			transform: scale(1.5);
			stroke-opacity: 0;
		}
	}
	@keyframes broadcast {
		0% {
			transform: scale(0.3);
			stroke-opacity: 0.9;
		}
		100% {
			transform: scale(9);
			stroke-opacity: 0;
		}
	}
	@keyframes eq {
		0% {
			transform: scaleY(0.25);
		}
		100% {
			transform: scaleY(1);
		}
	}
	@keyframes rise {
		0% {
			transform: translateY(40px);
			opacity: 0;
		}
		40% {
			opacity: 1;
		}
		100% {
			transform: translateY(-60px);
			opacity: 0;
		}
	}
	@keyframes twinkle {
		50% {
			opacity: 0.25;
		}
	}
	@keyframes float {
		50% {
			transform: translateY(-18px);
		}
	}

	/* Thumbnails stay calm until hovered, to keep the gate grid readable. */
	.world-thumb * {
		animation-play-state: paused;
	}
	:global(a:hover) .world-thumb *,
	:global(a:focus-visible) .world-thumb * {
		animation-play-state: running;
	}

	@media (prefers-reduced-motion: reduce) {
		.world-art * {
			animation: none !important;
		}
	}
</style>
