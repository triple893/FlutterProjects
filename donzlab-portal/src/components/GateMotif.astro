---
/**
 * The gold line-art crest on a gate card, one per world. Strokes use
 * currentColor so the card decides the tint; the dot is the vermilion accent.
 * On hover the card redraws the lines (Law 4: touching a gate wakes it).
 */
interface Props {
	world?: string | null;
	label: string;
}

const { world = "circuit", label } = Astro.props;
---

<svg class="motif" viewBox="0 0 200 140" role="img" aria-label={label}>
	{
		world === "circuit" && (
			<>
				<g fill="none" stroke="currentColor" stroke-width="1.2">
					<circle cx="100" cy="70" r="44" />
					<circle cx="100" cy="70" r="28" stroke-dasharray="2 5" />
					<path d="M100 6v20M100 114v20M20 70h36M144 70h36M20 70v-40h30M180 70v40h-30" />
				</g>
				<circle cx="100" cy="70" r="7" fill="var(--shu)" />
			</>
		)
	}
	{
		world === "strings" && (
			<>
				<g fill="none" stroke="currentColor" stroke-width="1.2">
					<path d="M10 30h180M10 46h180M10 62h180M10 78h180M10 94h180M10 110h180" />
					<path d="M50 20v100M95 20v100M140 20v100" stroke-width="3" opacity="0.35" />
				</g>
				<circle cx="72" cy="46" r="6" fill="var(--shu)" />
				<circle cx="118" cy="78" r="6" fill="currentColor" />
				<circle cx="164" cy="62" r="6" fill="currentColor" />
			</>
		)
	}
	{
		world === "sound" && (
			<>
				<g fill="none" stroke="currentColor" stroke-width="1.2">
					<path d="M40 120a60 60 0 0 1 120 0" />
					<path d="M60 120a40 40 0 0 1 80 0" />
					<path d="M80 120a20 20 0 0 1 40 0" />
					<path d="M20 120a80 80 0 0 1 160 0" stroke-dasharray="2 6" />
				</g>
				<circle cx="100" cy="120" r="6" fill="var(--shu)" />
			</>
		)
	}
	{
		world === "kitchen" && (
			<>
				<g fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round">
					<path d="M40 84h120a60 44 0 0 1-120 0z" />
					<path d="M70 70c-10-14 10-22 0-38M100 70c-10-14 10-22 0-38M130 70c-10-14 10-22 0-38" />
					<path d="M56 98c20 8 68 8 88 0" stroke-dasharray="3 5" />
				</g>
				<circle cx="100" cy="128" r="5" fill="var(--shu)" />
			</>
		)
	}
	{
		world === "signal" && (
			<>
				<g fill="none" stroke="currentColor" stroke-width="1.2">
					<path d="M78 48a30 30 0 0 0 0 44M122 48a30 30 0 0 1 0 44" />
					<path d="M60 30a56 56 0 0 0 0 80M140 30a56 56 0 0 1 0 80" />
					<path d="M42 14a82 82 0 0 0 0 112M158 14a82 82 0 0 1 0 112" stroke-dasharray="2 6" />
					<path d="M100 70v62" />
				</g>
				<circle cx="100" cy="70" r="7" fill="var(--shu)" />
			</>
		)
	}
	{
		world === "stage" && (
			<>
				<g fill="none" stroke="currentColor" stroke-width="1.2">
					<path d="M40 0l-28 120h56zM160 0l-28 120h56z" opacity="0.6" />
					<path d="M100 0l-30 120h60z" />
					<path d="M0 120h200" />
				</g>
				<path d="M100 46l5 13 13 5-13 5-5 13-5-13-13-5 13-5z" fill="var(--gold-soft)" />
			</>
		)
	}
	{
		world === "business" && (
			<>
				<g fill="none" stroke="currentColor" stroke-width="1.2">
					<path d="M20 120h160" />
					<rect x="36" y="74" width="22" height="46" />
					<rect x="72" y="52" width="22" height="68" />
					<rect x="108" y="64" width="22" height="56" />
					<rect x="144" y="28" width="22" height="92" />
				</g>
				<path d="M47 66L83 44 119 56 155 20" fill="none" stroke="var(--shu)" stroke-width="1.6" />
			</>
		)
	}
	{
		world === "constellation" && (
			<>
				<g fill="none" stroke="currentColor" stroke-width="1">
					<path d="M24 100L62 40 110 70 150 24 178 92 110 70 84 120 24 100" />
				</g>
				<g fill="var(--gold-soft)">
					<circle cx="24" cy="100" r="3" />
					<circle cx="62" cy="40" r="4" />
					<circle cx="150" cy="24" r="3" />
					<circle cx="178" cy="92" r="4" />
					<circle cx="84" cy="120" r="3" />
				</g>
				<circle cx="110" cy="70" r="6" fill="var(--shu)" />
			</>
		)
	}
	{
		world === "device" && (
			<>
				<g fill="none" stroke="currentColor" stroke-width="1.2">
					<rect x="72" y="8" width="56" height="112" rx="10" />
					<path d="M84 30h32M84 42h20M84 70h32v24H84z" />
					<rect x="34" y="34" width="28" height="56" rx="6" opacity="0.5" />
					<rect x="138" y="34" width="28" height="56" rx="6" opacity="0.5" />
				</g>
				<circle cx="100" cy="110" r="4" fill="var(--shu)" />
			</>
		)
	}
</svg>

<style>
	.motif {
		display: block;
		width: 100%;
		height: 160px;
	}

	.motif g {
		stroke-dasharray: 700;
		stroke-dashoffset: 0;
	}

	:global(a:hover) > * > .motif g,
	:global(a:focus-visible) > * > .motif g {
		animation: draw 1.1s cubic-bezier(0.6, 0, 0.2, 1);
	}

	@keyframes draw {
		from {
			stroke-dashoffset: 700;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		:global(a:hover) > * > .motif g {
			animation: none;
		}
	}
</style>
