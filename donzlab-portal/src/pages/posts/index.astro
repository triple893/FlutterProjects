---
import { getEmDashCollection } from "emdash";
import { Image } from "emdash/ui";
import Base from "../../layouts/Base.astro";
import { formatDate } from "../../utils/format";

const cursor = Astro.url.searchParams.get("cursor") || undefined;
const {
	entries: posts,
	cacheHint,
	nextCursor,
} = await getEmDashCollection("posts", {
	orderBy: { published_at: "desc" },
	limit: 20,
	cursor,
});
if (Astro.cache?.enabled) Astro.cache.set(cacheHint);
---

<Base title="開発日記" description="DonzLab の開発の記録">
	<p class="eyebrow">Devlog</p>
	<h1>開発日記</h1>

	{
		posts.length === 0 ? (
			<p class="meta">まだ日記はありません。</p>
		) : (
			<div class="grid">
				{posts.map((post) => (
					<a class="card" href={`/posts/${post.id}`}>
						{post.data.featured_image && (
							<div {...post.edit.featured_image}>
								<Image image={post.data.featured_image} />
							</div>
						)}
						<span class="meta">{formatDate(post.data.publishedAt)}</span>
						<h3 {...post.edit.title}>{post.data.title}</h3>
						{post.data.excerpt && <p {...post.edit.excerpt}>{post.data.excerpt}</p>}
					</a>
				))}
			</div>
		)
	}
	<nav class="pager" aria-label="ページ送り">
		{cursor && <a href="/posts">最初のページ</a>}
		{nextCursor && <a href={`/posts?cursor=${encodeURIComponent(nextCursor)}`}>次のページ →</a>}
	</nav>
</Base>

<style>
	.pager {
		display: flex;
		gap: 16px;
		margin-top: 24px;
	}
</style>
