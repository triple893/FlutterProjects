---
import { getMenuWithCacheHint, getSiteSettingsWithCacheHint } from "emdash";
import { EmDashHead, EmDashBodyStart, EmDashBodyEnd } from "emdash/ui";
import { createPublicPageContext } from "emdash/page";
import LiveSearch from "emdash/ui/search";
import { resolveStarterSiteIdentity } from "../utils/site-identity";
import "../styles/theme.css";

interface Props {
	title: string;
	pageTitle?: string | null;
	description?: string | null;
	image?: string | null;
	canonical?: string | null;
	/** Pass content reference for plugin page contributions on content pages */
	content?: { collection: string; id: string; slug?: string | null };
	/** castle = hub, world = inside a lab, business = clean corporate pages */
	mode?: "castle" | "world" | "business";
	/** Lab colour for world mode */
	accent?: string | null;
}

const { title, pageTitle, description, image, canonical, content, mode = "castle", accent } =
	Astro.props;
const accentStyle = accent && /^#[0-9a-f]{6}$/i.test(accent) ? `--accent:${accent}` : undefined;
const [settingsResult, menuResult] = await Promise.all([
	getSiteSettingsWithCacheHint(),
	getMenuWithCacheHint("primary"),
]);
if (Astro.cache?.enabled) {
	Astro.cache.set(settingsResult.cacheHint);
	Astro.cache.set(menuResult.cacheHint);
}

const { siteTitle, siteTagline, siteLogo } = resolveStarterSiteIdentity(
	settingsResult.data,
);
const titleIncludesSiteName =
	title === siteTitle ||
	title.endsWith(` | ${siteTitle}`) ||
	title.endsWith(` — ${siteTitle}`);
const fullTitle = titleIncludesSiteName ? title : `${title} — ${siteTitle}`;
const pageDescription = description ?? siteTagline;
const menu = menuResult.data;

// English sub-labels under the Japanese menu items, matched by destination.
const MENU_EN: Record<string, string> = {
	"/labs": "Gates",
	"/agents": "Codex",
	"/posts": "Chronicle",
	"/about": "About",
};

const pageCtx = createPublicPageContext({
	Astro,
	kind: content ? "content" : "custom",
	pageType: "website",
	title: fullTitle,
	pageTitle: pageTitle ?? title,
	description: pageDescription,
	canonical,
	image,
	content,
	siteName: siteTitle,
});
---

<!doctype html>
<html lang="ja">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>{fullTitle}</title>
		<meta name="theme-color" content={mode === "business" ? "#faf8f3" : "#0b0a09"} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			rel="stylesheet"
			href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=Shippori+Mincho+B1:wght@500;700;800&family=Zen+Kaku+Gothic+New:wght@400;500;700&display=swap"
		/>
		<EmDashHead page={pageCtx} />
	</head>
	<body data-mode={mode} style={accentStyle}>
		<EmDashBodyStart page={pageCtx} />

		<header class="site-header">
			<div class="container header-row">
				<a href="/" class="brand" aria-label={`${siteTitle} ホーム`}>
					{
						siteLogo ? (
							<img src={siteLogo.url} alt={siteLogo.alt || siteTitle} class="logo" />
						) : (
							<>
								<svg class="crest" width="34" height="34" viewBox="0 0 36 36" aria-hidden="true">
									<rect x="1" y="1" width="34" height="34" fill="none" stroke="currentColor" stroke-width="1" />
									<circle cx="18" cy="18" r="10" fill="none" stroke="currentColor" stroke-width="1.2" />
									<path d="M18 1v7M18 28v7M1 18h7M28 18h7" stroke="currentColor" stroke-width="1" />
									<circle cx="18" cy="18" r="3" fill="var(--shu)" />
								</svg>
								<span class="wordmark">DON'Z LAB</span>
							</>
						)
					}
				</a>
				<nav class="site-nav" aria-label="メインメニュー">
					{
						menu?.items.map((item) => (
							<a
								href={item.url}
								target={item.target}
								rel={item.target === "_blank" ? "noopener noreferrer" : undefined}
							>
								<span class="ja">{item.label}</span>
								{MENU_EN[item.url] && <span class="sub">{MENU_EN[item.url]}</span>}
							</a>
						))
					}
				</nav>
				<LiveSearch placeholder="検索…" collections={["labs", "agents", "posts", "pages"]} />
			</div>
		</header>

		<main>
			<slot />
		</main>

		<footer class="site-footer">
			<div class="container footer-inner">
				<p class="footer-mark" aria-hidden="true">DON'Z LAB</p>
				<div class="footer-row">
					<span>© Don'z Lab — {siteTagline}</span>
					<span class="footer-links">
						<a href="/about">私たちについて</a>
						<a href="https://x.com/aimagedon" rel="noopener noreferrer">X「AIまげ丼」</a>
					</span>
				</div>
			</div>
		</footer>

		<EmDashBodyEnd page={pageCtx} />
	</body>
</html>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 20;
		background: color-mix(in srgb, var(--ink) 82%, transparent);
		backdrop-filter: blur(12px);
		border-bottom: 1px solid var(--line);
		view-transition-name: site-header;
	}

	.header-row {
		display: flex;
		align-items: center;
		gap: 12px 32px;
		flex-wrap: wrap;
		padding-top: 14px;
		padding-bottom: 14px;
	}

	.brand {
		display: flex;
		align-items: center;
		gap: 12px;
		color: var(--gold);
	}

	.logo {
		height: 36px;
		width: auto;
		display: block;
	}

	.wordmark {
		font-family: var(--font-mono);
		font-size: 14px;
		letter-spacing: 0.32em;
		color: var(--text);
	}

	.site-nav {
		display: flex;
		gap: 8px 28px;
		flex: 1;
		justify-content: center;
		flex-wrap: wrap;
	}

	.site-nav a {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 2px;
		color: var(--text);
	}

	.site-nav .ja {
		font-size: 14px;
	}

	.site-nav .sub {
		font-family: var(--font-mono);
		font-size: 10px;
		letter-spacing: 0.2em;
		text-transform: uppercase;
		color: var(--text-faint);
	}

	.site-nav a:hover .sub {
		color: var(--gold);
	}

	.site-header :global(.emdash-live-search-input) {
		width: min(220px, 100%);
		min-height: 40px;
		padding: 8px 14px;
		border: 1px solid var(--line);
		border-radius: 0;
		background: transparent;
		color: var(--text);
		font: inherit;
		font-size: 13px;
	}

	.site-header :global(.emdash-live-search-input::placeholder) {
		color: var(--text-faint);
	}

	.site-header :global(.emdash-live-search-results) {
		background: var(--ink-raised);
		color: var(--text);
		border: 1px solid var(--line);
	}

	.site-footer {
		margin-top: 120px;
		border-top: 1px solid var(--line);
	}

	.footer-inner {
		padding-top: 72px;
		padding-bottom: 40px;
		display: flex;
		flex-direction: column;
		gap: 40px;
	}

	.footer-mark {
		margin: 0;
		font-family: var(--font-display);
		font-weight: 800;
		font-size: clamp(3.5rem, 12vw, 7.5rem);
		line-height: 1;
		letter-spacing: 0.04em;
		color: transparent;
		-webkit-text-stroke: 1px var(--gold);
	}

	.footer-row {
		display: flex;
		justify-content: space-between;
		gap: 16px 24px;
		flex-wrap: wrap;
		font-size: 13px;
		color: var(--text-faint);
	}

	.footer-links {
		display: flex;
		gap: 24px;
	}

	:global(body[data-mode="business"]) .brand {
		color: var(--text);
	}

	:global(body[data-mode="business"]) .footer-mark {
		-webkit-text-stroke-color: #cfc6b4;
		font-size: clamp(2.5rem, 7vw, 4rem);
	}

	@media (max-width: 720px) {
		.site-nav {
			justify-content: flex-start;
			order: 3;
			flex-basis: 100%;
		}
	}
</style>
